    {
      "parameters": {
        "jsCode": "// Parse the fields HubSpot puts in its Slack form-submission notification.\n// Replaces three LLM calls: the format is fixed, so a regex is instant,\n// free, deterministic and testable.\nconst text = $('IF HubSpot Message').first().json['Slack Message'][0].attachments[0].text || '';\n\nfunction field(label) {\n  const m = text.match(new RegExp('\\\\*' + label + '\\\\*:\\\\s*([^\\\\n]*)', 'i'));\n  return m ? m[1].trim() : '';\n}\n\n// Normalise like Slack's real_name_normalized: no accents, no special characters.\nfunction cleanName(raw) {\n  return raw\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^A-Za-z0-9 ]+/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nreturn [{\n  json: {\n    record_id: (field('Record ID').match(/\\d+/) || [''])[0],\n    contact_owner: cleanName(field('Contact owner')),\n    sdr_owner: cleanName(field('SDR Owner')),\n  },\n}];\n"
      },
