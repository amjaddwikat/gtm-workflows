    {
      "parameters": {
        "jsCode": "const html = $json[\"textHtml\"] || '';\nif (!html) {\n  return [\n    {\n      json: {\n        message: \"⚠️ Email does not contain HTML content.\"\n      }\n    }\n  ];\n}\n\nconst regex = /<a[^>]*href=\"([^\"]+)\"[^>]*>\\s*OPEN THE DOCUMENT\\s*<\\/a>/i;\nconst match = html.match(regex);\n\nif (match && match[1]) {\n  return [\n    {\n      json: {\n        documentLink: match[1],\n        message: `📄 You’ve received a new document via PandaDoc.\\n\\n👉 <${match[1]}|Open the Document>`\n      }\n    }\n  ];\n} else {\n  return [\n    {\n      json: {\n        message: \"⚠️ PandaDoc email received, but document link not found.\"\n      }\n    }\n  ];\n}\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "34fb8a51-0965-4b72-b76e-4b260b455f6b",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// Reject any approval callback that PandaDoc did not sign.\n// PandaDoc sends ?signature=<hex HMAC-SHA256 of the raw body, keyed with the\n// webhook's shared key>: https://developers.pandadoc.com/docs/webhook-verification\n// Requires: \"Raw Body\" enabled on the webhook node, NODE_FUNCTION_ALLOW_BUILTIN=crypto,\n// and the shared key in the PANDADOC_WEBHOOK_KEY environment variable.\nconst crypto = require('crypto');\n\nconst key = $env.PANDADOC_WEBHOOK_KEY;\nif (!key) throw new Error('PANDADOC_WEBHOOK_KEY is not set');\n\nconst received = String(($input.first().json.query || {}).signature || '');\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst expected = crypto.createHmac('sha256', key).update(raw).digest('hex');\n\nconst valid = received.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));\nif (!valid) throw new Error('Invalid PandaDoc webhook signature: request rejected');\n\nreturn $input.all();\n"
      },
      "name": "Verify PandaDoc Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
